<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coding Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#10213a; --muted:#5b6b82; --bg:#f4f6fa; --card:#ffffff;
  --line:#dde3ee; --accent:#0b8f8c; --accent-d:#076f6d; --sun:#ffb703;
  --radius:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6}
h1,h2,h3,.brand{font-family:"Space Grotesk",system-ui,sans-serif}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--sun);outline-offset:2px}

/* Header */
header{background:var(--ink);color:#fff;position:sticky;top:0;z-index:10}
.bar{max-width:1100px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.brand{font-size:1.35rem;font-weight:700;letter-spacing:-.01em}
.brand span{color:var(--sun)}
nav{display:flex;gap:6px}
nav button{background:none;border:0;color:#c6d2e4;font:600 .95rem Inter,sans-serif;padding:9px 18px;border-radius:999px;cursor:pointer;transition:background .2s,color .2s}
nav button:hover{color:#fff;background:rgba(255,255,255,.1)}
nav button.active{background:var(--sun);color:var(--ink)}

/* Hero */
.hero{background:var(--ink);color:#fff;padding:36px 20px 64px}
.hero-in{max-width:1100px;margin:auto}
.hero h1{font-size:clamp(1.9rem,5vw,3.2rem);line-height:1.1;max-width:18ch;letter-spacing:-.02em}
.hero p{margin-top:14px;color:#b7c4d9;max-width:52ch}
.code-chip{display:inline-block;margin-top:22px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:10px;padding:8px 14px;font:500 .9rem ui-monospace,Menlo,Consolas,monospace;color:#7fe3df}

main{max-width:1100px;margin:-34px auto 60px;padding:0 20px}
.panel{display:none}
.panel.active{display:block;animation:fade .25s ease}
@keyframes fade{from{opacity:0}to{opacity:1}}
.section-title{margin:0 0 6px;font-size:1.6rem}
.section-sub{color:var(--muted);margin-bottom:22px}

/* Gallery */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
.photo{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column}
.photo img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:#e6ebf3}
.photo div{padding:16px 18px 20px}
.photo h3{font-size:1.05rem;margin-bottom:6px}
.photo p{color:var(--muted);font-size:.92rem}

/* Form */
.form-wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:24px;align-items:start}
@media(max-width:820px){.form-wrap{grid-template-columns:1fr}}
.box{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px}
.field{margin-bottom:18px}
label,legend{display:block;font-weight:600;font-size:.92rem;margin-bottom:6px}
input[type=text],input[type=tel],select,textarea{width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:10px;font:inherit;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
textarea{min-height:90px;resize:vertical}
fieldset{border:0}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opts label{display:flex;align-items:center;gap:8px;margin:0;font-weight:500;border:1.5px solid var(--line);border-radius:999px;padding:7px 14px;cursor:pointer;transition:border-color .15s,background .15s}
.opts label:has(input:checked){border-color:var(--accent);background:#e4f6f5}
.opts input{accent-color:var(--accent)}
.hint{font-size:.8rem;color:var(--muted);margin-top:4px}
.err{color:#b3261e;font-size:.82rem;margin-top:4px;min-height:1em}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}
.btn{font:600 1rem Inter,sans-serif;padding:12px 22px;border-radius:10px;border:0;cursor:pointer}
.btn.primary{background:var(--accent);color:#fff}
.btn.primary:hover{background:var(--accent-d)}
.btn.ghost{background:#eef1f7;color:var(--ink)}

/* Result */
.empty{color:var(--muted);text-align:center;padding:30px 10px}
.entry{border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:12px;padding:16px 18px;margin-bottom:14px;background:#fbfdfd}
.entry h3{font-size:1.05rem;margin-bottom:8px}
.entry dl{display:grid;grid-template-columns:110px 1fr;gap:4px 10px;font-size:.92rem}
.entry dt{color:var(--muted)}
.entry dd{overflow-wrap:anywhere}
.tag{display:inline-block;background:#fff3cf;color:#7a5600;border-radius:999px;padding:1px 10px;font-size:.8rem;margin:0 4px 4px 0}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 20px;border-radius:10px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:20}
.toast.show{opacity:1}
footer{text-align:center;color:var(--muted);font-size:.85rem;padding:0 20px 30px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<header>
  <div class="bar">
    <div class="brand">Coding<span>Academy</span></div>
    <nav aria-label="Menu utama">
      <button class="active" data-tab="gallery">Gallery</button>
      <button data-tab="daftar">Pendaftaran</button>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-in">
    <h1>Belajar ngoding langsung dari praktik.</h1>
    <p>Kelas kecil, proyek nyata, dan mentor yang mendampingi dari dasar sampai siap kerja.</p>
    <span class="code-chip">console.log("Halo, calon developer!");</span>
  </div>
</section>

<main>
  <!-- GALLERY -->
  <section id="gallery" class="panel active">
    <h2 class="section-title">Gallery Kegiatan</h2>
    <p class="section-sub">Momen belajar di kelas, workshop, dan hackathon kami.</p>
    <div class="grid" id="galleryGrid"></div>
  </section>

  <!-- PENDAFTARAN -->
  <section id="daftar" class="panel">
    <h2 class="section-title">Pendaftaran Peserta</h2>
    <p class="section-sub">Isi data diri, lalu simpan. Semua kolom wajib diisi.</p>
    <div class="form-wrap">
      <form class="box" id="regForm" novalidate>
        <div class="field">
          <label for="nik">NIK</label>
          <input type="text" id="nik" inputmode="numeric" maxlength="16" placeholder="16 digit angka">
          <div class="err" data-err="nik"></div>
        </div>
        <div class="field">
          <label for="nama">Nama Lengkap</label>
          <input type="text" id="nama" placeholder="Sesuai KTP">
          <div class="err" data-err="nama"></div>
        </div>
        <fieldset class="field">
          <legend>Jenis Kelamin</legend>
          <div class="opts">
            <label><input type="radio" name="jk" value="Laki-laki"> Laki-laki</label>
            <label><input type="radio" name="jk" value="Perempuan"> Perempuan</label>
          </div>
          <div class="err" data-err="jk"></div>
        </fieldset>
        <div class="field">
          <label for="hp">No. HP</label>
          <input type="tel" id="hp" inputmode="tel" placeholder="08xxxxxxxxxx">
          <div class="err" data-err="hp"></div>
        </div>
        <div class="field">
          <label for="alamat">Alamat</label>
          <textarea id="alamat" placeholder="Jalan, kelurahan, kota"></textarea>
          <div class="err" data-err="alamat"></div>
        </div>
        <fieldset class="field">
          <legend>Bahasa Pemrograman yang Diminati</legend>
          <div class="opts">
            <label><input type="checkbox" name="bahasa" value="HTML/CSS"> HTML/CSS</label>
            <label><input type="checkbox" name="bahasa" value="JavaScript"> JavaScript</label>
            <label><input type="checkbox" name="bahasa" value="Python"> Python</label>
            <label><input type="checkbox" name="bahasa" value="Java"> Java</label>
            <label><input type="checkbox" name="bahasa" value="PHP"> PHP</label>
            <label><input type="checkbox" name="bahasa" value="Dart/Flutter"> Dart/Flutter</label>
          </div>
          <div class="hint">Boleh pilih lebih dari satu.</div>
          <div class="err" data-err="bahasa"></div>
        </fieldset>
        <div class="actions">
          <button type="submit" class="btn primary">Simpan pendaftaran</button>
          <button type="reset" class="btn ghost">Kosongkan form</button>
        </div>
      </form>

      <aside class="box" aria-live="polite">
        <h3 style="margin-bottom:14px">Data Pendaftar</h3>
        <div id="result"><p class="empty">Belum ada data tersimpan.</p></div>
      </aside>
    </div>
  </section>
</main>

<footer>&copy; <span id="yr"></span> Coding Academy</footer>
<div class="toast" id="toast" role="status"></div>

<script>
/* ---------- Data gallery ---------- */
const kegiatan = [
  {t:"Workshop Web Dasar",   d:"Peserta membangun halaman web pertama dengan HTML dan CSS.", c:["#0b8f8c","#10213a"], s:"</>"},
  {t:"Kelas JavaScript",     d:"Belajar logika, DOM, dan interaksi dengan studi kasus nyata.", c:["#ffb703","#c76b00"], s:"{ }"},
  {t:"Hackathon 24 Jam",     d:"Tim kecil membuat prototipe aplikasi dalam satu hari penuh.", c:["#5a4fcf","#10213a"], s:"24h"},
  {t:"Python untuk Data",    d:"Mengolah data sederhana dan membuat grafik dengan Python.", c:["#2a9d8f","#264653"], s:"py"},
  {t:"Sesi Mentoring",       d:"Diskusi karier dan review kode satu lawan satu bersama mentor.", c:["#e76f51","#7a2e1b"], s:"1:1"},
  {t:"Demo Day Proyek Akhir",d:"Peserta mempresentasikan proyek akhir di depan mentor dan mitra.", c:["#3a86ff","#10213a"], s:"▶️"}
];
function placeholder(c, s){
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="640" height="480" viewBox="0 0 640 480">
    <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${c[0]}"/><stop offset="1" stop-color="${c[1]}"/></linearGradient></defs>
    <rect width="640" height="480" fill="url(#g)"/>
    <rect x="70" y="80" width="500" height="320" rx="18" fill="rgba(255,255,255,.12)"/>
    <circle cx="105" cy="115" r="7" fill="rgba(255,255,255,.55)"/><circle cx="130" cy="115" r="7" fill="rgba(255,255,255,.55)"/><circle cx="155" cy="115" r="7" fill="rgba(255,255,255,.55)"/>
    <text x="320" y="285" font-family="monospace" font-size="96" font-weight="700" fill="#fff" text-anchor="middle">${s}</text>
  </svg>`;
  return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
}
const grid = document.getElementById("galleryGrid");
kegiatan.forEach(k=>{
  const el = document.createElement("article");
  el.className = "photo";
  el.innerHTML = `<img alt="${k.t}" loading="lazy" src="${placeholder(k.c,k.s)}"><div><h3>${k.t}</h3><p>${k.d}</p></div>`;
  grid.appendChild(el);
});
document.getElementById("yr").textContent = new Date().getFullYear();

/* ---------- Tab navigation ---------- */
const tabs = document.querySelectorAll("nav button");
const panels = document.querySelectorAll(".panel");
function showTab(id){
  tabs.forEach(b=>b.classList.toggle("active", b.dataset.tab===id));
  panels.forEach(p=>p.classList.toggle("active", p.id===id));
  window.scrollTo({top:0, behavior:"smooth"});
}
tabs.forEach(b=>b.addEventListener("click",()=>showTab(b.dataset.tab)));

/* ---------- Form ---------- */
const form = document.getElementById("regForm");
const result = document.getElementById("result");
const toast = document.getElementById("toast");
let jumlah = 0;

function esc(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));}
function setErr(k,msg){form.querySelector(`[data-err="${k}"]`).textContent = msg||"";}
function showToast(msg){
  toast.textContent = msg; toast.classList.add("show");
  setTimeout(()=>toast.classList.remove("show"), 2500);
}

function ambilData(){
  return {
    nik: form.nik.value.trim(),
    nama: form.nama.value.trim(),
    jk: (form.querySelector('input[name="jk"]:checked')||{}).value || "",
    hp: form.hp.value.trim(),
    alamat: form.alamat.value.trim(),
    bahasa: [...form.querySelectorAll('input[name="bahasa"]:checked')].map(c=>c.value)
  };
}

function validasi(d){
  let ok = true;
  const cek = (k,cond,msg)=>{ setErr(k, cond?"":msg); if(!cond) ok=false; };
  cek("nik", /^\d{16}$/.test(d.nik), "NIK harus 16 digit angka.");
  cek("nama", d.nama.length >= 3, "Nama lengkap minimal 3 karakter.");
  cek("jk", !!d.jk, "Pilih jenis kelamin.");
  cek("hp", /^(\+62|62|0)8\d{8,12}$/.test(d.hp), "Nomor HP tidak valid. Contoh: 081234567890.");
  cek("alamat", d.alamat.length >= 10, "Alamat minimal 10 karakter.");
  cek("bahasa", d.bahasa.length > 0, "Pilih minimal satu bahasa pemrograman.");
  return ok;
}

form.addEventListener("submit", e=>{
  e.preventDefault();
  const d = ambilData();
  if(!validasi(d)) return;

  // Konfirmasi penyimpanan
  if(confirm("Apakah Anda sudah yakin untuk menyimpan?")){
    // OK -> tampilkan data
    if(jumlah === 0) result.innerHTML = "";
    jumlah++;
    const card = document.createElement("div");
    card.className = "entry";
    card.innerHTML = `
      <h3>Pendaftar #${jumlah}: ${esc(d.nama)}</h3>
      <dl>
        <dt>NIK</dt><dd>${esc(d.nik)}</dd>
        <dt>Jenis Kelamin</dt><dd>${esc(d.jk)}</dd>
        <dt>No. HP</dt><dd>${esc(d.hp)}</dd>
        <dt>Alamat</dt><dd>${esc(d.alamat)}</dd>
        <dt>Minat</dt><dd>${d.bahasa.map(b=>`<span class="tag">${esc(b)}</span>`).join("")}</dd>
      </dl>`;
    result.prepend(card);
    form.reset();
    showToast("Data berhasil disimpan.");
  } else {
    // Batal -> proses penyimpanan dibatalkan
    showToast("Penyimpanan dibatalkan.");
  }
});

form.addEventListener("reset",()=>form.querySelectorAll(".err").forEach(e=>e.textContent=""));
</script>
</body>
</html>
